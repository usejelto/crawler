{
  "name": "@jelto/crawler",
  "version": "1.0.2",
  "description": "Optional server crawler request reporting for Jelto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usejelto/crawler.git"
  },
  "bugs": {
    "url": "https://github.com/usejelto/crawler/issues"
  },
  "homepage": "https://jelto.io/docs/sdk/crawler",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "bun": "./dist/index.js",
      "deno": "./dist/index.js",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "GUIDE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/prepare-package.mjs",
    "pretest": "npm run build",
    "test": "node --test src/index.test.ts",
    "preconformance": "npm run build",
    "conformance": "node --test src/index.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
